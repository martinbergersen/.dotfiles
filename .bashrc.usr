# Enable Git branch visibility in the prompt
source /usr/lib/git-core/git-sh-prompt

# Custom Prompt: [User@Host] [Directory] (GitBranch) $
export PS1='\[\e[1;32m\][\u@\h] \[\e[1;34m\]\w \[\e[1;33m\]$(__git_ps1 "(%s)") \[\e[0m\]\$ '
export GIT_PS1_SHOWDIRTYSTATE=1
export GIT_PS1_SHOWCOLORHINTS=1

# Aliases
alias grm="git rm"
alias gmv="git mv"
alias ll="ls -lah"
