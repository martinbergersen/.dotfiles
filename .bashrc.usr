# === PROMPT ===

# Enable Git status in prompt:
if [ -f /usr/lib/git-core/git-sh-prompt ]; then
  source /usr/lib/git-core/git-sh-prompt
  export GIT_PS1_SHOWCOLORHINTS=1
  export GIT_PS1_SHOWDIRTYSTATE=1
  export GIT_PS1_SHOWSTASHSTATE=1
  export GIT_PS1_SHOWUNTRACKEDFILES=1
  export GIT_PS1_SHOWUPSTREAM="auto"

  # Prompt: User@Host:Directory (GitBranch GitStatus) $
  export PS1='\[\e[1;32m\]\u@\h\[\e[0m\]:\[\e[1;34m\]\w \[\e[0m\]$(__git_ps1 "(%s)")\n⤷\$ '
fi

# === ALIASES ===
alias grm="git rm"
alias gmv="git mv"
alias gstat="git status"
alias gcom="git add . && git commit -am"
alias ll="ls -lh"
alias la="ls -lah"
alias wt="date '+%T'"         # What time?
alias wd="date '+%A %d %B'"   # What day?
alias ww="date '+%V'"         # What week?

# === MOTD ===
#uptime
